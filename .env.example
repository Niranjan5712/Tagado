# Copy to .env and fill in values. Never commit .env.
# No AI provider keys belong in this project.

# SQLite path is relative to the backend working directory when using uvicorn from backend/
DATABASE_URL=sqlite:///./data/tagado.db

# Public base URL of this app (no trailing slash). Used for review/client links later.
APP_URL=http://localhost:8000

# Signed session cookie secret (use a long random string in any shared/deployed environment)
SESSION_SECRET=change-me-to-a-long-random-string

# Shared secret for POST /api/cron/tick (Phase 3+)
CRON_SECRET=change-me-cron-secret

# Demo owner login (seeded on first boot)
DEMO_EMAIL=demo@tagado.app
DEMO_PASSWORD=tagado-demo-2026
DEMO_OWNER_NAME=Priya
DEMO_BUSINESS_NAME=Pixelcraft Studio
